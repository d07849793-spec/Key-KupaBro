--------------------------------------------------------------------
-- 3. ВКЛАДКА: УВЕДОМЛЕНИЕ (SendNotification)
--------------------------------------------------------------------
local NotifTitle = "Kupa Scripts & Mops Scripts"
local NotifText = "Скрипт успешно загружен и запущен!"
local NotifDuration = 5
local ButtonTitleText = "ОК"
local SelectedAction = "Запуск скрипта"
local KickReasonText = "Вас кикнули"
local ScriptUrlText = "print('Executed!')"

Tabs.Custom:AddInput("NotifTitleInput", {
    Title = "Заголовок (Сверху)",
    Default = NotifTitle,
    Placeholder = "Введи заголовок...",
    Callback = function(Value) NotifTitle = Value end
})

Tabs.Custom:AddInput("NotifTextInput", {
    Title = "Текст сообщения (Снизу)",
    Default = NotifText,
    Placeholder = "Введи текст...",
    Callback = function(Value) NotifText = Value end
})

Tabs.Custom:AddInput("NotifDurationInput", {
    Title = "Сколько секунд висит уведомление (Duration)",
    Default = "5",
    Placeholder = "Секунды...",
    Callback = function(Value) NotifDuration = tonumber(Value) or 5 end
})

Tabs.Custom:AddDropdown("ActionDropdown", {
    Title = "Действие при нажатии на кнопку",
    Values = {"Без кнопки", "Кик (Кастом причина)", "Запуск скрипта"},
    Default = "Запуск скрипта",
    Callback = function(Value) SelectedAction = Value end
})

Tabs.Custom:AddInput("ButtonTitleInput", {
    Title = "Название кнопки в уведомлении",
    Default = ButtonTitleText,
    Placeholder = "Например: Запустить / Нажать / ОК",
    Callback = function(Value) ButtonTitleText = Value end
})

Tabs.Custom:AddInput("KickReasonInput", {
    Title = "Причина кика (если выбран Кик)",
    Default = KickReasonText,
    Callback = function(Value) KickReasonText = Value end
})

Tabs.Custom:AddInput("ScriptUrlInput", {
    Title = "Код / Ссылка на скрипт (если выбран Запуск)",
    Default = ScriptUrlText,
    Callback = function(Value) ScriptUrlText = Value end
})

Tabs.Custom:AddButton({
    Title = "Показать уведомление (SendNotification)",
    Callback = function()
        local StarterGui = game:GetService("StarterGui")
        local notifData = {
            Title = NotifTitle,
            Text = NotifText,
            Duration = NotifDuration
        }

        if SelectedAction ~= "Без кнопки" then
            -- Устанавливаем кастомное имя кнопки
            notifData.Button1 = ButtonTitleText ~= "" and ButtonTitleText or "Кнопка"
            
            local bindable = Instance.new("BindableFunction")
            bindable.OnInvoke = function(pressedButton)
                if SelectedAction == "Кик (Кастом причина)" then
                    game.Players.LocalPlayer:Kick(KickReasonText)
                elseif SelectedAction == "Запуск скрипта" then
                    if ScriptUrlText:find("http") then
                        loadstring(game:HttpGet(ScriptUrlText))()
                    else
                        loadstring(ScriptUrlText)()
                    end
                end
            end
            
            notifData.Callback = bindable
        end

        StarterGui:SetCore("SendNotification", notifData)
    end
})

