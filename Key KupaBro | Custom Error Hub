-- 1. ВКЛАДКА: ЧАТ
--------------------------------------------------------------------
local ChatPlayerName = "System"
local ChatMessageText = "Скрипт успешно запущен!"

Tabs.Chat:AddInput("ChatPlayerInput", {
    Title = "Никнейм игрока",
    Default = ChatPlayerName,
    Placeholder = "Введи ник...",
    Callback = function(Value) ChatPlayerName = Value end
})

Tabs.Chat:AddInput("ChatMessageInput", {
    Title = "Текст сообщения",
    Default = ChatMessageText,
    Placeholder = "Введи текст...",
    Callback = function(Value) ChatMessageText = Value end
})

Tabs.Chat:AddButton({
    Title = "Отправить сообщение в чат",
    Callback = function()
        local TextChatService = game:GetService("TextChatService")
        local StarterGui = game:GetService("StarterGui")
        
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel:DisplaySystemMessage("[" .. ChatPlayerName .. "]: " .. ChatMessageText)
            end
        else
            StarterGui:SetCore("ChatMakeSystemMessage", {
                Text = "[" .. ChatPlayerName .. "]: " .. ChatMessageText,
                Color = Color3.fromRGB(255, 255, 255),
                Font = Enum.Font.SourceSansBold,
                TextSize = 18
            })
        end
    end
})

