local function parseTimeString(str)
    local totalSeconds = 0
    if not str then return 0 end
    
    for num, unit in str:gmatch("(%d+)([dsmh])") do
        local n = tonumber(num) or 0
        if unit == "d" then totalSeconds = totalSeconds + (n * 86400)
        elseif unit == "h" then totalSeconds = totalSeconds + (n * 3600)
        elseif unit == "m" then totalSeconds = totalSeconds + (n * 60)
        elseif unit == "s" then totalSeconds = totalSeconds + n
        end
    end
    return totalSeconds
end

local function formatRemainingTime(totalSec)
    local d = math.floor(totalSec / 86400)
    local h = math.floor((totalSec % 86400) / 3600)
    local m = math.floor((totalSec % 3600) / 60)
    local s = totalSec % 60
    
    local parts = {}
    if d > 0 then table.insert(parts, d .. "d") end
    if h > 0 then table.insert(parts, h .. "h") end
    if m > 0 then table.insert(parts, m .. "m") end
    if s > 0 or #parts == 0 then table.insert(parts, s .. "s") end
    
    return table.concat(parts, " ")
end

