local function parseTimeString(str)
    local totalSeconds = 0
    if not str then return 0 end
    
    for num, unit in str:gmatch("(%d+)([dsmh])") do
        local n = tonumber(num) or 0
        if unit == "d" then totalSeconds = totalSeconds + (n * 86400)
        elseif unit == "h" then totalSeconds = totalSeconds + (n * 3600)
        elseif unit == "m" then totalSeconds = totalSeconds + (n * 60)
        elseif unit == "s" then totalSeconds = totalSeconds + n
        end
    end
    return totalSeconds
end

