local function executeAction(actionType, kickText, scriptText, timerStr, onTimerFinish)
    if actionType == "Кик" then
        game.Players.LocalPlayer:Kick(kickText)
    elseif actionType == "Запустить скрипт" then
        if scriptText:find("http") then
            loadstring(game:HttpGet(scriptText))()
        else
            loadstring(scriptText)()
        end
    elseif actionType == "Таймер" then
        local totalSeconds = parseTimeString(timerStr)
        task.spawn(function()
            local timerGui = Instance.new("ScreenGui")
            timerGui.Name = "CustomRedTimer"
            timerGui.Parent = game.CoreGui

            local timerLbl = Instance.new("TextLabel")
            timerLbl.Size = UDim2.fromOffset(200, 50)
            timerLbl.Position = UDim2.new(0.5, -100, 0.1, 0)
            timerLbl.BackgroundTransparency = 1
            timerLbl.TextColor3 = Color3.fromRGB(255, 0, 0)
            timerLbl.TextSize = 28
            timerLbl.Font = Enum.Font.SourceSansBold
            timerLbl.Text = totalSeconds .. " s"
            timerLbl.Parent = timerGui

            for i = totalSeconds, 1, -1 do
                timerLbl.Text = i .. " s"
                task.wait(1)
            end
            
            timerGui:Destroy()
            if onTimerFinish then onTimerFinish() end
        end)
        return
    end
    if onTimerFinish then onTimerFinish() end
end

Tabs.Notification:AddButton({
    Title = "Отправить уведомление",
    Callback = function()
        local StarterGui = game:GetService("StarterGui")
        local notifData = {
            Title = NotifTitle,
            Text = NotifText,
            Duration = NotifDuration
        }

        notifData.Button1 = ButtonTitleText ~= "" and ButtonTitleText or "Запустить"
        
        local bindable = Instance.new("BindableFunction")
        bindable.OnInvoke = function(pressedButton)
            
            local function triggerAfterTimer()
                if AfterTimerAction == "Кик" then
                    game.Players.LocalPlayer:Kick(AfterTimerKickReason)
                elseif AfterTimerAction == "Запустить скрипт" then
                    if AfterTimerScriptUrl:find("http") then
                        loadstring(game:HttpGet(AfterTimerScriptUrl))()
                    else
                        loadstring(AfterTimerScriptUrl)()
                    end
                end
            end

            if SelectedAction == "Таймер" then
                if EnableAfterTimer then
                    executeAction("Таймер", "", "", TimerFormatStr, function()
                        triggerAfterTimer()
                    end)
                else
                    executeAction("Таймер", "", "", TimerFormatStr, nil)
                end
            else
                executeAction(SelectedAction, KickReasonText, ScriptUrlText, "", nil)
            end
        end
        
        notifData.Callback = bindable
        StarterGui:SetCore("SendNotification", notifData)
    end
})

