local function executeAction(actionType, kickText, scriptText, timerStr, onTimerFinish)
    if actionType == "Кик" then
        game.Players.LocalPlayer:Kick(kickText)
    elseif actionType == "Запустить скрипт" then
        if scriptText:find("http") then
            loadstring(game:HttpGet(scriptText))()
        else
            loadstring(scriptText)()
        end
    elseif actionType == "Таймер" then
        local totalSeconds = parseTimeString(timerStr)
        activeTimersCount = activeTimersCount + 1

        task.spawn(function()
            local timerGui = nil
            local timerLbl = nil
            local rainbowConn = nil

            if not HideTimerUI then
                timerGui = Instance.new("ScreenGui")
                timerGui.Name = "CustomRedTimer"
                timerGui.Parent = game.CoreGui

                timerLbl = Instance.new("TextLabel")
                timerLbl.Size = UDim2.fromOffset(400, 50)
                timerLbl.Position = UDim2.new(0.5, -200, 0.1, 0)
                timerLbl.BackgroundTransparency = 1
                timerLbl.TextColor3 = timerColor
                timerLbl.TextSize = 24
                timerLbl.Font = Enum.Font.SourceSansBold
                timerLbl.Text = formatRemainingTime(totalSeconds)
                timerLbl.Parent = timerGui

                if isRainbowTimerActive then
                    local runService = game:GetService("RunService")
                    local hue = 0
                    rainbowConn = runService.RenderStepped:Connect(function()
                        if not timerLbl or not timerLbl.Parent then
                            if rainbowConn then rainbowConn:Disconnect() end
                            return
                        end
                        hue = (tick() * 0.2) % 1
                        timerLbl.TextColor3 = Color3.fromHSV(hue, 1, 1)
                    end)
                end
            end

            for i = totalSeconds - 1, 0, -1 do
                if activeTimersCount <= 0 then break end
                
                currentTimerTextDisplay = formatRemainingTime(i + 1)
                task.wait(1)
                if timerLbl and timerLbl.Parent then
                    timerLbl.Text = formatRemainingTime(i)
                end
            end
            
            if rainbowConn then rainbowConn:Disconnect() end
            if timerGui and timerGui.Parent then
                timerGui:Destroy()
            end

            activeTimersCount = math.max(0, activeTimersCount - 1)
            if activeTimersCount == 0 then
                currentTimerTextDisplay = "Нет активных таймеров"
            end

            if onTimerFinish and activeTimersCount >= 0 then onTimerFinish() end
        end)
        return
    end
    if onTimerFinish then onTimerFinish() end
end

Tabs.Notification:AddButton({
    Title = "Отправить уведомление",
    Callback = function()
        local StarterGui = game:GetService("StarterGui")
        local notifData = {
            Title = NotifTitle,
            Text = NotifText,
            Duration = NotifDuration
        }

        notifData.Button1 = ButtonTitleText ~= "" and ButtonTitleText or "Запустить"
        
        local bindable = Instance.new("BindableFunction")
        bindable.OnInvoke = function(pressedButton)
            local function triggerAfterTimer()
                if AfterTimerAction == "Кик" then
                    game.Players.LocalPlayer:Kick(AfterTimerKickReason)
                elseif AfterTimerAction == "Запустить скрипт" then
                    if AfterTimerScriptUrl:find("http") then
                        loadstring(game:HttpGet(AfterTimerScriptUrl))()
                    else
                        loadstring(AfterTimerScriptUrl)()
                    end
                end
            end

            if SelectedAction == "Таймер" then
                if EnableAfterTimer then
                    executeAction("Таймер", "", "", TimerFormatStr, function()
                        triggerAfterTimer()
                    end)
                else
                    executeAction("Таймер", "", "", TimerFormatStr, nil)
                end
            else
                executeAction(SelectedAction, KickReasonText, ScriptUrlText, "", nil)
            end
        end
        
        notifData.Callback = bindable
        StarterGui:SetCore("SendNotification", notifData)
    end
})

